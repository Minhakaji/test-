# Cong server
PORT=3000

# Bi mat dung de ky JWT - KHONG commit gia tri that len git
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h

# Duong dan file SQLite (se duoc tao tu dong neu chua ton tai)
DB_PATH=./data/app.sqlite

# Cau hinh chong do mat khau (brute-force)
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MS=60000
LOGIN_LOCKOUT_MS=60000
